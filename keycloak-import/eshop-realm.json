      }
    },
    {
      "clientId": "eshop-product-service",
      "name": "Product Microservice",
      "description": "Confidential client for product service token validation",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "display.on.consent.screen": "false"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-eshop-backend",
      "enabled": true,
      "serviceAccountClientId": "eshop-backend",
      "realmRoles": [
        "default-roles-eshop",
        "offline_access"
      ],
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users",
          "query-users",
          "view-realm",
          "query-realms",
          "query-groups",
          "view-events"
        ]
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT",
        "guiOrder": "1",
        "hideOnLoginPage": "false"
      }
    },
    {
      "alias": "facebook",
      "providerId": "facebook",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
