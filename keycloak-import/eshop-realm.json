        {
          "name": "phone-number-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "phoneNumber",
            "claim.name": "phone_number",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "eshop-backend",
      "name": "E-Shop Backend Service Account",
      "description": "Confidential client for backend service-to-Keycloak communication",
      "enabled": true,
      "publicClient": false,
      "secret": "${ESHOP_BACKEND_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "clientAuthenticatorType": "client-secret",
      "frontchannelLogout": false,
      "attributes": {
        "display.on.consent.screen": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "backchannel.logout.session.required": "false",
        "backchannel.logout.revoke.offline.tokens": "false"
      }
    },
    {
      "clientId": "eshop-order-service",
      "name": "Order Microservice",
      "description": "Confidential client for order service token validation",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "display.on.consent.screen": "false"
      }
    },
    {
      "clientId": "eshop-payment-service",
      "name": "Payment Microservice",
      "description": "Confidential client for payment service token validation",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "display.on.consent.screen": "false"
      }
    },
    {
      "clientId": "eshop-delivery-service",
      "name": "Delivery Microservice",
      "description": "Confidential client for delivery service token validation",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
