# ==============================================================================
# ESHOP API - Environment Variable Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Update the values below with your local configuration.
# 3. DO NOT commit the .env file to version control.
# ==============================================================================

# --- Server Configuration ---
PORT=8082
CONTEXT_PATH=/api
SPRING_PROFILES_ACTIVE=dev,oauth2,prod,test

# --- Database Configuration (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/eshop_db
DB_USERNAME=postgres
DB_PASSWORD=ythamilu*884*
DB_POOL_SIZE=10

# --- Security & Auth (Keycloak / JWT) ---
# FATAL: Application will fail to start if JWT_SECRET is missing.
JWT_SECRET=your_super_secret_key_at_least_256_bits_long_1234567890
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# FATAL: Application will fail to start if ENCRYPTION_KEY is missing.
# Used by AttributeEncryptor to AES-256-GCM encrypt PII columns (profiles, bank accounts) at rest.
ENCRYPTION_KEY=your_pii_encryption_passphrase_change_me

# FATAL: Application will fail to start if OAUTH2_STATE_SIGNING_KEY is missing or under 32 bytes.
# HMAC-SHA256 key signing the OAuth2 "state" CSRF token. Must be a real secret, not the repo default.
OAUTH2_STATE_SIGNING_KEY=your_oauth2_state_signing_key_at_least_32_bytes_long

# --- Keycloak Configuration ---
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=eshop
ESHOP_BACKEND_CLIENT_ID=eshop-backend
KEYCLOAK_ADMIN_CLIENT_ID=eshop-admin-backend
ESHOP_BACKEND_CLIENT_SECRET=your_client_secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=your_admin_password
KEYCLOAK_ADMIN_CLIENT_ID=eshop-admin-backend

# --- Keycloak Admin Realm (eshop-admin) ---
# This is a SEPARATE, dedicated Keycloak realm from KEYCLOAK_REALM above — see
# keycloak-import/eshop-admin-realm.json and keycloak-import/ADMIN_REALM_README.md.
# ADMIN_REALM_NAME must match the "realm" field in eshop-admin-realm.json ("eshop-admin").
# Do not leave this unset in production — the app's admin issuer-uri falls back to
# Keycloak's own "master" realm if unset, which is a different (and far more sensitive)
# security domain than this application's admin role.
ADMIN_REALM_NAME=eshop-admin
# FATAL (realm import): required to substitute ${ADMIN_EMAIL}/${ADMIN_INITIAL_PASSWORD}/
# ${ESHOP_ADMIN_BACKEND_SECRET} in eshop-admin-realm.json — without these, Keycloak either
# fails to import the realm or imports it with a literal, publicly-known placeholder value.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=change_me_temporary_admin_password
ESHOP_ADMIN_BACKEND_SECRET=your_admin_backend_client_secret
# Set to true once real email delivery is configured for the admin realm (email verification).
KC_VERIFY_EMAIL_ADMIN=false
# Set to true once real email delivery is configured for the eshop realm.
KC_VERIFY_EMAIL=false

# --- Keycloak Realm Import SMTP (both eshop and eshop-admin realms) ---
# Distinct from MAIL_* below, which is the Spring app's own mail sender — these configure
# the email server Keycloak itself uses for verification/reset emails in the imported realms.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_REPLY_TO=admin@yourdomain.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_SSL=false
SMTP_STARTTLS=false

# --- CORS Settings ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Frontend Origin (Keycloak OAuth2 redirect URIs) ---
# Used to substitute ${FRONTEND_URL} in keycloak-import/eshop-realm.json's eshop-client
# redirectUris/webOrigins. Defaults to http://localhost:3000 if unset (dev only) — the
# production compose file requires this to be set explicitly. Single origin, no trailing
# slash, no path (e.g. https://shop.yourdomain.com).
FRONTEND_URL=http://localhost:3000

# --- Payment Gateways (all optional — disabled unless payment.{gateway}.enabled=true) ---
# Stripe: required when payment.stripe.enabled=true (see PaymentProperties/StripeConfigValidator).
# The webhook secret is also used to verify incoming /api/v1/webhooks/payment/stripe calls — a
# blank/unset secret means Stripe webhooks are REJECTED (fail-closed), never silently trusted.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
# Razorpay: required when payment.razorpay.enabled=true (see RazorpayConfigValidator). Same
# fail-closed rule applies to the webhook secret.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# PayU / Cashfree / UPI: no SDK integration yet (see payment module review) — only webhook
# signature verification is implemented. Same fail-closed rule: blank = webhook rejected.
PAYMENT_PAYU_SALT=your_payu_salt
PAYMENT_PAYU_KEY=your_payu_merchant_key
PAYMENT_CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
PAYMENT_UPI_WEBHOOK_SECRET=your_upi_provider_webhook_secret

# --- Cloudflare R2 Storage Configuration ---
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-custom-domain.com
R2_REGION=auto

# --- OAuth2 / Google (Optional) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- OAuth2 / Facebook (Optional) ---
# Referenced by keycloak-import/eshop-realm.json's identity provider config.
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# --- Mail Configuration ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null

# --- OpenAPI Metadata ---
API_TITLE=EShop API
API_VERSION=1.0.0
SERVER_URL=http://localhost:8080

# --- Business Logic Defaults ---
DEFAULT_COMMISSION_RATE=0.05
DEFAULT_CURRENCY=USD

# --- Role Names (for dynamic security mapping) ---
ADMIN_ROLE=ADMIN
SELLER_ROLE=SELLER
CUSTOMER_ROLE=CUSTOMER
DELIVERY_AGENT_ROLE=DELIVERY_AGENT
